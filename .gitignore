# ── Secrets — never commit these ─────────────────────────────────────
.env
.env.*
!.env.example
# Vite inlines every VITE_* value into the client bundle at build time, so these
# are readable by anyone who opens the shipped JavaScript. They are public
# addresses, not credentials, and committing them is what makes the Vercel build
# self-contained rather than dependent on dashboard state.
!frontend/.env.production
*.pem
*.key
credentials.json
service-account*.json

# ── Python ───────────────────────────────────────────────────────────
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ─────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── Runtime output ───────────────────────────────────────────────────
runs/
data/
uploads/
*.db
*.db-wal
*.db-shm
.run/
*.log

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
