# Copy to .env and fill in. Never commit .env — it is gitignored for a reason.
#
# MeetAI boots and runs with none of the optional keys set. Features that
# need one report themselves as unconfigured instead of failing.

# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="MeetAI"
APP_VERSION="2.0.0"
DEBUG=true
ENVIRONMENT=development          # development | staging | production

# ─── Security (REQUIRED) ────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ─── Persistence ────────────────────────────────────────────────────────────
# auto    – MongoDB when reachable, otherwise SQLite  (default)
# sqlite  – zero setup, persists to SQLITE_PATH
# mongodb – requires MONGODB_URL to be reachable; fails loudly if it is not
#
# Use an explicit `mongodb` in production. On `auto`, an Atlas outage silently
# falls back to SQLite on what may be an ephemeral disk.
DATABASE_BACKEND=sqlite
SQLITE_PATH=./data/meetai.db

MONGODB_URL=
MONGODB_DB_NAME=meetai

# ─── LiveKit — required for video ───────────────────────────────────────────
# Free tier: https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Groq — required for transcription and AI reports ───────────────────────
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# llama3-70b-8192 and llama-3.1-70b-versatile are both decommissioned.
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LLM_FAST_MODEL=llama-3.1-8b-instant

# ─── Google Calendar OAuth2 (optional) ──────────────────────────────────────
# https://console.cloud.google.com/ — enable the Google Calendar API and add
# GOOGLE_REDIRECT_URI to the client's authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth2callback

# ─── AES-256 field encryption (optional) ────────────────────────────────────
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ─── CORS ───────────────────────────────────────────────────────────────────
# Exact origins, no trailing slash. Narrow this to your domain in production.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173","http://127.0.0.1:5173","http://127.0.0.1:4173"]
