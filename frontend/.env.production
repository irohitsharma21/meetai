# Production build values. Vite loads this automatically for `vite build`.
#
# Nothing secret belongs here: every VITE_* variable is substituted into the
# bundle and served to the browser. Secrets stay on the backend.
VITE_API_URL=https://meetai-api.onrender.com

# wss://, not ws://. A page served over HTTPS cannot open an insecure
# WebSocket - the browser blocks it as mixed content and live transcription
# never connects, with no error the user can see.
VITE_WS_URL=wss://meetai-api.onrender.com

VITE_LIVEKIT_URL=wss://seed-1ddzc0ju.livekit.cloud
